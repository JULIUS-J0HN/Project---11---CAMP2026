############################################################
# AstroCell v1.0
# Faithful translation of the STEPS astrocyte model
############################################################

begin parameters

#===========================================================
# Diffusion (m2/s)
#===========================================================

D_CA              1.30e-11
D_IP3             2.80e-10
D_GCAMP           5.00e-11

#===========================================================
# Initial concentrations
#===========================================================

CA_INIT           1.0e-7
IP3_INIT          0
GCAMP_INIT        1.0e-5
PLC_INIT          1000

#===========================================================
# Reaction constants
#===========================================================

KF_GCAMP          7.78e6
KB_GCAMP          1.12

K_CA_DECAY        30
K_CA_LEAK         1.5e-7

K_IP3_DECAY       1.2e-4
K_PLC             1

KF_CAA            1.2e6
KB_CAA            50

KF_CAI            1.6e4
KB_CAI            100

KF_IP3            4.1e7
KB_IP3            400

K_FLUX            6000

end parameters


############################################################
# Molecule Types
############################################################

begin molecule types

ca()

ip3()

plc()

GCaMP6s()

ca_GCaMP6s()

unb_IP3R()

ip3_IP3R()

caa_IP3R()

cai_IP3R()

open_IP3R()

cai_ip3_IP3R()

ca2_IP3R()

ca2_ip3_IP3R()

end molecule types


############################################################
# Compartments
############################################################

begin compartments

EC      3      1

CP      3      1      EC

ERM     2      1      CP

PM      2      1      EC

end compartments
